{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jerica-pro",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "assets": {
    "directory": "./public"
  },
  "routes": [
    {
      "pattern": "jerica.pro",
      "custom_domain": true
    },
    {
      "pattern": "www.jerica.pro",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
