{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jerica-pro",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Board"
      ]
    },
    {
      "tag": "v2",
      "deleted_classes": [
        "Board"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "jerica.pro",
      "custom_domain": true
    },
    {
      "pattern": "www.jerica.pro",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
